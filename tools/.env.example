# ==============================================================================
# Imperva Incapsula Event Collector (Local PC) Configuration Template
# Copy this file to .env and fill in your actual credentials/settings:
#   cp .env.example .env
# ==============================================================================

# --- Authentication & Connection ---
# Imperva Cloud Security API ID and API Key
API_ID=your_api_id_here
API_KEY=your_api_key_here

# Imperva Log Server URL (must point to your assigned log server endpoint)
# e.g., https://logs.incapsula.com/ or https://logs1.incapsula.com/
URL=https://logs.incapsula.com/

# SSL Certificate verification (true / false)
SSL_VERIFY=false

# --- Collection & Filtering Settings ---
# Maximum number of log files to download and process per execution
MAX_LOGS=10

# Starting numeric file ID to collect from (e.g., 0 for beginning, or a specific file index)
STARTING_FILE_ID=0

# --- Output & State Management ---
# Destination directory where event log files will be saved
OUTPUT_DIR=.

# Prefix for output event files (generates: imperva_events_YYYYMMDD_HHMMSS.log)
OUTPUT_PREFIX=imperva_events

# State file used to track the latest processed file ID across runs
STATE_FILE=state.json

# (Optional) Direct output file override. If set, derives output directory and prefix automatically.
# OUTPUT_FILE=./imperva_events.log
